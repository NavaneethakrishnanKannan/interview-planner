# Copy to repo root as `.env` only (Nest, Next, Docker, and Prisma all use this file).
# Web
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-random
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
# App/runtime: transaction pooler (6543). Migrations use DIRECT_URL — must not be the 6543 pooler.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Migrate/introspection: session pooler (5432) OR direct host db.<project-ref>.supabase.co:5432 (from Supabase Connect → Prisma).
DIRECT_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres?sslmode=require
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
OPENAI_API_KEY=replace-with-openai-key
REDIS_HOST=localhost
REDIS_PORT=6379
