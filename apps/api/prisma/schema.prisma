generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewType {
  FRONTEND
  FULLSTACK
  SENIOR
  STAFF
  PRINCIPAL
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String?
  passwordHash      String?
  googleId          String?              @unique
  role              Role                 @default(USER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  refreshTokens     RefreshToken[]
  interviewSessions InterviewSession[]
  notes             Note[]
  bookmarks         QuestionBookmark[]
  progressRecords   ProgressTracking[]
  submissions       CodingSubmission[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  questions   Question[]
}

model Question {
  id                String             @id @default(cuid())
  title             String
  prompt            String
  answer            String
  realWorldExample  String?
  followUpQuestions String[]
  difficulty        QuestionDifficulty
  seniority         String
  tags              String[]
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookmarks         QuestionBookmark[]
}

model QuestionBookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model InterviewSession {
  id           String             @id @default(cuid())
  userId       String
  type         InterviewType
  topic        String
  startedAt    DateTime           @default(now())
  endedAt      DateTime?
  readiness    Int                @default(0)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     InterviewMessage[]
  scoreCards   Score[]
  notes        Note[]
  diagrams     ArchitectureDiagram[]
}

model InterviewMessage {
  id          String           @id @default(cuid())
  sessionId   String
  role        String
  content     String
  createdAt   DateTime         @default(now())
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Note {
  id          String           @id @default(cuid())
  userId      String
  sessionId   String?
  title       String?
  content     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
}

model CodingSubmission {
  id             String   @id @default(cuid())
  userId         String
  problemTitle   String
  language       String
  code           String
  testResult     Json?
  score          Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArchitectureDiagram {
  id          String           @id @default(cuid())
  sessionId   String
  title       String
  nodes       Json
  edges       Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Score {
  id                   String           @id @default(cuid())
  sessionId            String
  technicalDepth       Int
  clarity              Int
  completeness         Int
  weakAreas            String[]
  strongAreas          String[]
  improvementPlan      String
  createdAt            DateTime         @default(now())
  session              InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  targetType    String
  targetId      String
  feedback      String
  createdAt     DateTime @default(now())
}

model ProgressTracking {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  masteryScore  Int      @default(0)
  attempts      Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}
